PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
JWT_SECRET=replace_with_secure_long_random_string
JWT_EXPIRE=30d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Nivel de log (pino): fatal | error | warn | info | debug | trace
# Default si se omite: "info" en production, "debug" en cualquier otro entorno.
LOG_LEVEL=debug

# Email (Resend) - recordatorios de citas, bienvenida, reportes de uso y campañas.
# Crear cuenta en https://resend.com, generar un API Key y verificar un dominio
# propio (SPF/DKIM) para que los correos no caigan en spam.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=NutriPro <noreply@tudominio.com>

# Twilio SMS Configuration (for appointment reminders)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Cloudinary (file storage for patient documents/photos — required in production;
# sin esto, los uploads en Vercel no persisten entre invocaciones)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vercel Cron (protege el endpoint de recordatorios contra invocaciones externas)
CRON_SECRET=replace_with_a_random_string
