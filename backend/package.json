{
  "name": "nutrition-platform-backend",
  "version": "1.0.0",
  "description": "Backend API for Nutrition Platform SaaS",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test:connection": "node src/scripts/testConnection.js",
    "seed:all": "node src/scripts/seedUsers.js && node src/scripts/seedFoods.js && node src/scripts/seedTemplates.js && node src/scripts/seedGeneratedTemplates.js",
    "seed:foods": "node src/scripts/seedFoods.js",
    "seed:templates": "node src/scripts/seedTemplates.js",
    "seed:users": "node src/scripts/seedUsers.js",
    "seed:generated-templates": "node src/scripts/seedGeneratedTemplates.js",
    "seed:generated-templates:dry-run": "node src/scripts/seedGeneratedTemplates.js --dry-run",
    "audit:patients": "node src/scripts/auditPatients.js",
    "test:reminders": "node src/scripts/testReminders.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "nutrition",
    "health",
    "saas"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "twilio": "^5.11.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
